    "autoprefixer": "10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "wrangler": "^4.105.0"
